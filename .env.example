# HeadlessX v2.1.0
# Local development environment

# Database
DATABASE_URL="postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# API server
PORT=38473
HOST=0.0.0.0
NODE_ENV=development

# Required security
# Used by the Next.js dashboard server to authenticate against the API.
DASHBOARD_INTERNAL_API_KEY=replace-with-a-long-random-string

# Used to encrypt stored credentials at rest.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-different-long-random-string

# Dashboard session auth (recommended before public exposure)
# Production defaults to enabled. Set to false only for local trusted environments.
DASHBOARD_AUTH_ENABLED=true
# Production lock: auth cannot be disabled unless explicitly set to true.
# Keep this unset/false in production.
# DASHBOARD_AUTH_ALLOW_DISABLE_IN_PRODUCTION=false

# Shared secret used to sign dashboard session JWT (minimum 32 chars).
DASHBOARD_AUTH_SECRET=replace-with-a-third-long-random-string

# Dashboard login identity
DASHBOARD_AUTH_USERNAME=admin

# Recommended: store only a scrypt hash. Format: scrypt:<salt-base64url>:<hash-base64url>
# Legacy format scrypt$<salt>$<hash> is supported, but requires escaping `$` in dotenv files.
# Generate with:
# node -e "const { randomBytes, scryptSync } = require('crypto'); const p='ChangeMe!'; const salt=randomBytes(16); const hash=scryptSync(p, salt, 64, {N:16384,r:8,p:1,maxmem:64*1024*1024}); const b=v=>v.toString('base64url'); console.log(`scrypt:${b(salt)}:${b(hash)}`);"
DASHBOARD_AUTH_PASSWORD_HASH=

# Local fallback only (disabled in production when hash is missing)
# DASHBOARD_AUTH_PASSWORD=change-me-local-only

# Optional overrides
# DASHBOARD_AUTH_SESSION_TTL_SECONDS=28800
# DASHBOARD_AUTH_COOKIE_NAME=hx_dashboard_session
# DASHBOARD_AUTH_COOKIE_DOMAIN=dashboard.example.com
# DASHBOARD_AUTH_SECURE_COOKIES=true
# DASHBOARD_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# DASHBOARD_AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
# DASHBOARD_AUTH_RATE_LIMIT_PREFIX=hx:dashboard:auth:login
# DASHBOARD_AUTH_RATE_LIMIT_FAIL_OPEN=false

# Queue and Redis (required for distributed dashboard login rate limiting)
REDIS_URL=redis://localhost:36379

# Search providers
TAVILY_API_KEY=
EXA_API_KEY=

# Local engines
YT_ENGINE_URL=http://localhost:38090
YT_ENGINE_PORT=38090
YT_ENGINE_TIMEOUT_MS=45000
YT_ENGINE_TEMP_DIR=./tmp/yt-engine
YT_ENGINE_JOB_TTL_HOURS=12

HTML_TO_MARKDOWN_SERVICE_URL=http://localhost:38081
HTML_TO_MARKDOWN_PORT=38081
HTML_TO_MARKDOWN_TIMEOUT_MS=60000

# Browser and stealth defaults are managed in the dashboard settings UI.

# Web dashboard
WEB_PORT=34872
NEXT_PUBLIC_API_URL=http://localhost:38473
# When accessing `next dev` via LAN IPs, list allowed hostnames (no protocol/port).
# NEXT_ALLOWED_DEV_ORIGINS=192.168.3.27,devbox.local

# Set this for Docker or custom internal networking.
# INTERNAL_API_URL=http://localhost:38473

# Set this only when the dashboard is hosted on a custom origin.
# FRONTEND_URL=https://dashboard.example.com
